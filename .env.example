# ====== 豆包API配置模板 ======
# 复制本文件为 .env 或直接在系统环境变量中配置

# 1. 火山方舟 API Key（必填）
# 获取方式：登录火山引擎控制台 -> 火山方舟 -> API Key管理
# 地址：https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey
ARK_API_KEY=

# 2. 使用的模型ID（可选，默认 doubao-seed-2-1-pro-260628）
# 更多模型ID见：https://www.volcengine.com/docs/82379/1330310
# 推荐：
#   doubao-seed-2-1-pro-260628      # 主力深度思考模型，代码能力强
#   doubao-seed-2-1-lite-260628     # 轻量快速模型，响应快
#   doubao-1-5-pro-32k-250115       # 豆包1.5专业版 32K上下文
#   doubao-pro-32k                  # 豆包专业版
ARK_MODEL_ID=doubao-seed-2-1-pro-260628

# 3. API Base URL（一般无需修改）
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ====== 基元律动 TokenRhythm API 配置 ======
# 使用方式：config.json 中 CLIENT_MODE 设为 "jiyuan"
# 接口：OpenAI 兼容，Base URL 为 https://tokenrhythm.studio/v1
# 可用模型示例：deepseek-v4-flash / deepseek-v4-pro / glm-5
JIYUAN_API_KEY=
JIYUAN_BASE_URL=https://tokenrhythm.studio/v1
JIYUAN_MODEL=deepseek-v4-flash
